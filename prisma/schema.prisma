// رصد — مخطط قاعدة البيانات
// القيود التي لا يعبّر عنها Prisma (CHECK، Triggers، Sequence) موجودة في
// prisma/migrations/20261123000100_integrity/migration.sql

generator client {
  provider      = "prisma-client-js"
  // native = جهاز البناء، rhel-openssl-3.0.x = دوال Netlify/Vercel/AWS Lambda
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  ADMIN
  WAREHOUSE
  HUB_MANAGER
  DRIVER
}

enum PointType {
  WAREHOUSE
  HUB
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  INACTIVE
}

/// الحالات اللونية الخمس
enum StockColor {
  ORANGE // متاح في المستودع
  BLUE // خارج المستودع (عهدة سائق)
  GREEN // سُلّم للعميل
  RED // تالف / ناقص / مفقود
  PURPLE // مرتجع سليم بانتظار الفرز
}

/// نوع الحركة الواحدة على كمية منتج
enum MovementType {
  STOCK_IN
  DISPATCH
  DELIVERED
  RETURN_GOOD
  RETURN_DAMAGED
  SHORTAGE
  SORT_TO_AVAILABLE
  SORT_TO_DAMAGED
  RESOLVE_RED
  WRITE_OFF
  CUSTOMER_RETURN
  TRANSFER
  STATUS_CHANGE
}

/// نوع العملية (السند) التي تجمع حركة أو أكثر
enum OperationKind {
  STOCK_IN
  DISPATCH
  DELIVERY
  RETURN
  SORTING
  RED_RESOLUTION
  CUSTOMER_RETURN
  TRANSFER
  SETTLEMENT
  ADJUSTMENT
}

enum OperationStatus {
  COMPLETED
  PENDING_DRIVER_ACK
  ACKNOWLEDGED
}

enum ScanSource {
  CAMERA
  EXTERNAL_SCANNER
  MANUAL
}

// ───────────────────────── Master data ─────────────────────────

model DeliveryPoint {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String    @unique
  type      PointType @default(HUB)
  address   String?
  phone     String?
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  users          User[]
  drivers        Driver[]
  balances       StockColorBalance[]
  custody        DriverCustody[]
  units          InventoryUnit[]
  operations     Operation[]         @relation("OperationPoint")
  movementsFrom  StockMovement[]     @relation("MovementFromPoint")
  movementsTo    StockMovement[]     @relation("MovementToPoint")
  operationsDest Operation[]         @relation("OperationToPoint")

  @@map("delivery_points")
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String    @map("password_hash")
  role            Role
  deliveryPointId String?   @map("delivery_point_id")
  isActive        Boolean   @default(true) @map("is_active")
  /// يزداد عند تغيير كلمة المرور أو التعطيل لإبطال الجلسات القديمة
  tokenVersion    Int       @default(0) @map("token_version")
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  deliveryPoint DeliveryPoint?  @relation(fields: [deliveryPointId], references: [id])
  driver        Driver?
  operations    Operation[]     @relation("OperationPerformedBy")
  acknowledged  Operation[]     @relation("OperationAcknowledgedBy")
  movements     StockMovement[]
  settlements   Settlement[]
  auditLogs     AuditLog[]

  @@index([role])
  @@map("users")
}

model Driver {
  id              String       @id @default(cuid())
  userId          String?      @unique @map("user_id")
  fullName        String       @map("full_name")
  phone           String
  altPhone        String?      @map("alt_phone")
  address         String?
  nationalId      String       @unique @map("national_id")
  vehicleType     String?      @map("vehicle_type")
  vehiclePlate    String?      @map("vehicle_plate")
  deliveryPointId String       @map("delivery_point_id")
  status          DriverStatus @default(AVAILABLE)
  notes           String?
  lastSettledAt   DateTime?    @map("last_settled_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User?           @relation(fields: [userId], references: [id])
  deliveryPoint DeliveryPoint   @relation(fields: [deliveryPointId], references: [id])
  custody       DriverCustody[]
  units         InventoryUnit[]
  operations    Operation[]
  movements     StockMovement[]
  settlements   Settlement[]

  @@index([deliveryPointId])
  @@index([status])
  @@map("drivers")
}

model Customer {
  id            String   @id @default(cuid())
  name          String
  phone         String
  altPhone      String?  @map("alt_phone")
  address       String?
  deliveryNotes String?  @map("delivery_notes")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  operations Operation[]
  movements  StockMovement[]

  @@index([phone])
  @@index([name])
  @@map("customers")
}

model Product {
  id            String   @id @default(cuid())
  name          String
  sku           String   @unique
  barcode       String   @unique
  category      String
  unit          String   @default("قطعة")
  price         Decimal  @db.Decimal(12, 2)
  cost          Decimal  @db.Decimal(12, 2)
  minStockAlert Int      @default(0) @map("min_stock_alert")
  /// true = تتبع كل قطعة برقم تسلسلي في inventory_units
  trackUnits    Boolean  @default(false) @map("track_units")
  imageUrl      String?  @map("image_url")
  isArchived    Boolean  @default(false) @map("is_archived")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  balances  StockColorBalance[]
  custody   DriverCustody[]
  units     InventoryUnit[]
  movements StockMovement[]

  @@index([category])
  @@index([name])
  @@map("products")
}

// ───────────────────────── Stock state ─────────────────────────

/// رصيد مخبّأ لكل (منتج، نقطة، لون). يُحدَّث في نفس Transaction التي تُدخل الحركة.
/// يمكن إعادة حسابه دائماً من stock_movements (أداة reconcile).
model StockColorBalance {
  id              String     @id @default(cuid())
  productId       String     @map("product_id")
  deliveryPointId String     @map("delivery_point_id")
  color           StockColor
  quantity        Int        @default(0)
  /// متى أصبح الرصيد أكبر من صفر (لتنبيهات الأحمر المتأخر)
  nonzeroSince    DateTime?  @map("nonzero_since") @db.Timestamptz(3)
  updatedAt       DateTime   @default(now()) @map("updated_at") @db.Timestamptz(3)

  product       Product       @relation(fields: [productId], references: [id])
  deliveryPoint DeliveryPoint @relation(fields: [deliveryPointId], references: [id])

  @@unique([productId, deliveryPointId, color])
  @@index([color, quantity])
  @@index([deliveryPointId, color])
  @@map("stock_color_balances")
}

/// عهدة السائق لكل (سائق، منتج، نقطة المصدر). مجموعها = الرصيد الأزرق.
model DriverCustody {
  id              String    @id @default(cuid())
  driverId        String    @map("driver_id")
  productId       String    @map("product_id")
  deliveryPointId String    @map("delivery_point_id")
  quantity        Int       @default(0)
  nonzeroSince    DateTime? @map("nonzero_since") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  driver        Driver        @relation(fields: [driverId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])
  deliveryPoint DeliveryPoint @relation(fields: [deliveryPointId], references: [id])

  @@unique([driverId, productId, deliveryPointId])
  @@index([driverId, quantity])
  @@map("driver_custody")
}

/// قطع فردية (للمنتجات ذات track_units = true فقط)
model InventoryUnit {
  id              String      @id @default(cuid())
  productId       String      @map("product_id")
  serial          String      @unique
  /// null = مشطوبة وخارج النظام
  color           StockColor?
  deliveryPointId String?     @map("delivery_point_id")
  driverId        String?     @map("driver_id")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @default(now()) @map("updated_at") @db.Timestamptz(3)

  product       Product        @relation(fields: [productId], references: [id])
  deliveryPoint DeliveryPoint? @relation(fields: [deliveryPointId], references: [id])
  driver        Driver?        @relation(fields: [driverId], references: [id])

  @@index([productId, color, deliveryPointId])
  @@index([driverId])
  @@map("inventory_units")
}

// ───────────────────────── Ledger ─────────────────────────

/// سند/عملية واحدة (صرف، تسليم، إرجاع...). تحمل مفتاح منع التكرار.
model Operation {
  id                String          @id @default(cuid())
  opNo              String          @unique @map("op_no")
  kind              OperationKind
  status            OperationStatus @default(COMPLETED)
  deliveryPointId   String?         @map("delivery_point_id")
  toDeliveryPointId String?         @map("to_delivery_point_id")
  driverId          String?         @map("driver_id")
  customerId        String?         @map("customer_id")
  reason            String?
  notes             String?
  idempotencyKey    String          @unique @map("idempotency_key")
  /// بصمة محتوى الطلب لاكتشاف إعادة استخدام المفتاح بطلب مختلف
  requestHash       String          @map("request_hash")
  performedById     String          @map("performed_by")
  acknowledgedAt    DateTime?       @map("acknowledged_at") @db.Timestamptz(3)
  acknowledgedById  String?         @map("acknowledged_by")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  deliveryPoint   DeliveryPoint?  @relation("OperationPoint", fields: [deliveryPointId], references: [id])
  toDeliveryPoint DeliveryPoint?  @relation("OperationToPoint", fields: [toDeliveryPointId], references: [id])
  driver          Driver?         @relation(fields: [driverId], references: [id])
  customer        Customer?       @relation(fields: [customerId], references: [id])
  performedBy     User            @relation("OperationPerformedBy", fields: [performedById], references: [id])
  acknowledgedBy  User?           @relation("OperationAcknowledgedBy", fields: [acknowledgedById], references: [id])
  movements       StockMovement[]
  settlement      Settlement?

  @@index([kind, createdAt])
  @@index([driverId, createdAt])
  @@index([status])
  @@map("operations")
}

/// سجل الحركات — للإضافة فقط (Trigger يمنع UPDATE/DELETE/TRUNCATE).
/// قاعدة الأرصدة: كل حركة تُنقص (from_color, from_point) وتزيد (to_color, to_point).
model StockMovement {
  id             String       @id @default(cuid())
  movementNo     Int          @unique @default(autoincrement()) @map("movement_no")
  operationId    String       @map("operation_id")
  type           MovementType
  productId      String       @map("product_id")
  quantity       Int
  fromColor      StockColor?  @map("from_color")
  fromPointId    String?      @map("from_point_id")
  toColor        StockColor?  @map("to_color")
  toPointId      String?      @map("to_point_id")
  driverId       String?      @map("driver_id")
  customerId     String?      @map("customer_id")
  unitSerials    String[]     @default([]) @map("unit_serials")
  scannedBarcode String?      @map("scanned_barcode")
  scanSource     ScanSource?  @map("scan_source")
  reason         String?
  notes          String?
  performedById  String       @map("performed_by")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  operation   Operation      @relation(fields: [operationId], references: [id])
  product     Product        @relation(fields: [productId], references: [id])
  fromPoint   DeliveryPoint? @relation("MovementFromPoint", fields: [fromPointId], references: [id])
  toPoint     DeliveryPoint? @relation("MovementToPoint", fields: [toPointId], references: [id])
  driver      Driver?        @relation(fields: [driverId], references: [id])
  customer    Customer?      @relation(fields: [customerId], references: [id])
  performedBy User           @relation(fields: [performedById], references: [id])

  @@index([productId, createdAt])
  @@index([driverId, createdAt])
  @@index([operationId])
  @@index([customerId])
  @@index([fromPointId, fromColor])
  @@index([toPointId, toColor])
  @@index([scannedBarcode])
  @@index([createdAt])
  @@map("stock_movements")
}

model Settlement {
  id          String    @id @default(cuid())
  driverId    String    @map("driver_id")
  operationId String    @unique @map("operation_id")
  settledById String    @map("settled_by")
  summary     Json
  periodStart DateTime? @map("period_start") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  driver    Driver    @relation(fields: [driverId], references: [id])
  operation Operation @relation(fields: [operationId], references: [id])
  settledBy User      @relation(fields: [settledById], references: [id])

  @@index([driverId, createdAt])
  @@map("settlements")
}

// ───────────────────────── Security & config ─────────────────────────

/// سجل تدقيق للإضافة فقط، مع سلسلة تجزئة SHA-256 لاكتشاف التلاعب.
model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  prevHash   String   @map("prev_hash")
  hash       String   @unique
  createdAt  DateTime @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model Setting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settings")
}

/// محاولات الدخول الفاشلة (يعمل مع عدة خوادم Serverless لأنه في قاعدة البيانات)
model LoginAttempt {
  key         String    @id
  failures    Int       @default(0)
  windowStart DateTime  @map("window_start") @db.Timestamptz(3)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(3)

  @@map("login_attempts")
}
