# انسخ هذا الملف إلى .env وعدّل القيم. لا ترفع .env إلى GitHub أبداً.

# رابط قاعدة البيانات (Pooled). على Neon استخدم الرابط الذي يحتوي "-pooler".
DATABASE_URL="postgresql://rasd:rasd@localhost:5432/rasd?schema=public"
# رابط مباشر بدون Pooler (تستخدمه أوامر migrate). محلياً ضع نفس القيمة.
DIRECT_URL="postgresql://rasd:rasd@localhost:5432/rasd?schema=public"

# مفتاح توقيع الجلسات: 32 حرفاً على الأقل. ولّده بالأمر:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"

# مدة الجلسة بالساعات
SESSION_HOURS="12"

# --- البيانات الأولية (seed) ---
# بيانات حساب المدير الأول. إذا تُركت فارغة يُستخدم الحساب التجريبي admin@rasd.local
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# true = إضافة بيانات تجريبية كاملة (منتجات، سائقون، حركات). false = مدير فقط.
SEED_DEMO="true"
