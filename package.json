{
  "name": "rasd",
  "version": "1.0.0",
  "private": true,
  "description": "رصد — نظام إدارة الدليفري والمستودعات بنظام الألوان",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "deploy-build": "prisma generate && prisma migrate deploy && next build",
    "vercel-build": "npm run deploy-build",
    "start": "next start",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "reconcile": "tsx scripts/reconcile.ts",
    "audit:verify": "tsx scripts/verify-audit.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "effect": "^3.22.5",
    "deepmerge-ts": "^8.0.2"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "html5-qrcode": "2.3.8",
    "jose": "^6.2.18",
    "jsbarcode": "^3.12.3",
    "next": "16.4.6",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.1.1"
  }
}
